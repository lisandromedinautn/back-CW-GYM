# Copiá este archivo como .env y completá los valores. El .env no se versiona.

# API
PUERTO=3000
URL_FRONT=http://localhost:5173

# Base de desarrollo (docker compose: servicio bd-desarrollo)
BD_SERVIDOR=localhost
BD_PUERTO=5442
BD_USUARIO=gimnasio
BD_CLAVE=gimnasio
BD_NOMBRE=gimnasio_desarrollo
# true solo en desarrollo y test: TypeORM crea las tablas a partir de las entidades.
BD_SINCRONIZAR=true

# Admin inicial (RN-IDE-14): lo crea `yarn seed`. Elegí un email y una contraseña propios.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT (RN-IDE-01). Secreto largo y aleatorio; expiración en formato jsonwebtoken (8h, 1d).
JWT_SECRETO=
JWT_EXPIRACION=8h

# Semilla de usuarios de prueba (RN-IDE-12): contraseña común de profesor01..03 y alumno01..20@cwgym.test.
SEMILLA_CONTRASENIA=
